# Server configuration
PORT=5000
JWT_SECRET=leaveflow_jwt_secret_token_change_in_production

# PostgreSQL Database config (optional, system falls back to JSON file database if empty or fails)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leaveflow

# Individual connection fields (alternative)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=leaveflow

# Fallback JSON File database path (used if PostgreSQL connection fails)
DB_FALLBACK_PATH=./data/db.json

# Manager Registration Secret Code (required to sign up as a manager/approver)
MANAGER_SECRET_CODE=LEAVEFLOW_ADMIN_2026

